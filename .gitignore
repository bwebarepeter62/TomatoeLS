# ==========================================================
# Tomato Leaf Scan — Master Git Ignore Rules
# ==========================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Configurations & Secrets
.env
.env.local
.env.*.local
!.env.example

# SQLite runtime locks
*.db-journal
*.db-wal
*.sqlite3-journal

# Uploaded test inspection photos (keep directory structure)
web-app/frontend/static/uploads/leaf_*.jpg
static/uploads/leaf_*.jpg

# Flutter & Dart (Mobile App)
mobile-app/.dart_tool/
mobile-app/.flutter-plugins
mobile-app/.flutter-plugins-dependencies
mobile-app/.pub-cache/
mobile-app/.pub/
mobile-app/build/
mobile-app/.packages
mobile-app/android/app/debug/
mobile-app/android/app/profile/
mobile-app/android/app/release/
mobile-app/android/build/
mobile-app/ios/Flutter/.last_build_id
mobile-app/ios/Flutter/ephemeral/
mobile-app/windows/flutter/ephemeral/
mobile-app/linux/flutter/ephemeral/
mobile-app/macos/Flutter/ephemeral/

# Legacy root Flutter build rules
.dart_tool/
.flutter-plugins*
.pub-cache/
.pub/
/build/

# IDE & Editor files
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Database backups created by scripts/reset_db.py
web-app/database/leafscan_backup_*.db
