        farm_id = int(raw_farm_id)

    limit = min(200, max(1, int(request.args.get('limit', 100))))
    offset = max(0, int(request.args.get('offset', 0)))

    scans = db.list_scans(
        search=search,
        status_filter=status_filter,
        farm_id=farm_id,
        sort_order=sort_order,
        limit=limit,
        offset=offset,
    )
    return jsonify({'status': 'ok', 'scans': scans})


