MODEL = None


def clean_label(raw_label: str) -> str:
    return LABEL_MAP.get(raw_label, raw_label)


def ensure_model_loaded() -> Any:
    global MODEL
    if MODEL is None:
        resolved_path = next((p for p in MODEL_CANDIDATES if os.path.exists(p)), None)
        if not resolved_path:
            raise FileNotFoundError(f'Model file was not found at {MODEL_PATH}.')

        custom_objects = {}
        try:
            import keras
            if hasattr(keras, 'Operation'):
                class TrueDivide(keras.Operation):
                    def __init__(self, name=None, **kwargs):
                        super().__init__(name=name)
                    def call(self, x1, x2):
                        return keras.ops.true_divide(x1, x2)
                    def compute_output_spec(self, x1, x2):
                        return keras.KerasTensor(x1.shape, dtype=x1.dtype)

                class Subtract(keras.Operation):
                    def __init__(self, name=None, **kwargs):
                        super().__init__(name=name)
                    def call(self, x1, x2):
                        return keras.ops.subtract(x1, x2)
                    def compute_output_spec(self, x1, x2):
                        return keras.KerasTensor(x1.shape, dtype=x1.dtype)

                custom_objects['TrueDivide'] = TrueDivide
                custom_objects['Subtract'] = Subtract
        except Exception:
            pass

        MODEL = tf.keras.models.load_model(
            resolved_path,
            custom_objects=custom_objects if custom_objects else None,
            compile=False,
        )
    return MODEL


def build_result_for_image(image: Image.Image) -> dict[str, Any]:
    model = ensure_model_loaded()

    # Rule 2: Input images resized to 224x224 pixels (always RGB)
    resized = image.convert('RGB').resize((224, 224), Image.Resampling.BILINEAR)

    # Converted to a numpy array
    arr = np.asarray(resized, dtype=np.float32)

    # Ensure 3 channels RGB
    if arr.ndim == 2:
        arr = np.stack([arr] * 3, axis=-1)
    elif arr.shape[-1] == 4:
        arr = arr[..., :3]

    # Expanded to shape (1, 224, 224, 3)
    arr = np.expand_dims(arr, axis=0)

    # NOTE: Do NOT call mobilenet_v2.preprocess_input here. The saved model already
    # contains the rescaling layers (x / 127.5 - 1) right after its augmentation block,
    # so it expects raw 0-255 pixel values. Applying it twice squashed every image to
    # near-constant input and biased results toward the blight classes.

    # Rule 3: The 3 Classes probabilities
    # Index 0: Early Blight, Index 1: Late Blight, Index 2: Healthy
    raw_predictions = model.predict(arr)
    if isinstance(raw_predictions, (list, tuple)):
        raw_predictions = raw_predictions[0]
    probabilities = np.asarray(raw_predictions).squeeze()

    predicted_index = int(np.argmax(probabilities))
    raw_class_name = CLASS_NAMES[predicted_index]
    confidence_score = float(probabilities[predicted_index])
    confidence_pct = round(confidence_score * 100.0, 2)

    # Rule 4: No Blight Logic
    # If the prediction evaluates to the 'Healthy' class, override the standard label
    # and format the final return message to explicitly state:
    # 'No blight disease detected. The leaf is healthy.'
    is_healthy = (predicted_index == 2 or raw_class_name == 'Healthy')

    if is_healthy:
        final_label = 'No blight disease detected. The leaf is healthy.'
        return_message = 'No blight disease detected. The leaf is healthy.'
        disease_info = {
            'name': 'No blight disease detected. The leaf is healthy.',
            'type': 'healthy',
            'summary': 'No blight disease detected. The leaf is healthy.',
            'cause': 'No blight disease detected. The leaf is healthy.',
            'effects': ['No yield loss expected from this leaf. Healthy photosynthetic tissue.'],
            'stopNow': ['Nothing to treat right now', 'Scout every 3-4 days'],
            'preventSpread': ['Wash hands and tools between plots', 'Quarantine new seedlings for a week'],
            'preventFuture': ['Water at base in the morning', 'Mulch the soil and ensure airflow', 'Check leaves weekly'],
            'treatments': ['Bio spray (optional)', 'Mulch and airflow'],
            'seeExpertIf': 'No action required unless symptoms change.',
        }
    else:
        final_label = raw_class_name
        return_message = f'{raw_class_name} detected.'
        disease_info = DAMAGE_DB.get(raw_class_name, {
            'name': raw_class_name,
            'type': 'fungal',
            'summary': f'Detected {raw_class_name}. Review recommended treatments and containment steps below.',
            'cause': 'Fungal pathogen affecting tomato foliage.',
            'effects': ['Photosynthetic loss', 'Foliage decay'],
            'stopNow': ['Prune affected foliage', 'Avoid overhead watering'],
            'preventSpread': ['Disinfect pruning tools', 'Space plants for airflow'],
            'preventFuture': ['Crop rotation', 'Fungicide schedule'],
            'treatments': ['Fungicide spray', 'Sanitation'],
            'seeExpertIf': 'Symptoms spread rapidly across the crop.',
        })

    all_predictions = [
        {
            'class': CLASS_NAMES[i],
            'label': 'No blight disease detected. The leaf is healthy.' if i == 2 else CLASS_NAMES[i],
            'confidence': round(float(probabilities[i]) * 100.0, 2),
            'probability': float(probabilities[i]),
        }
        for i in range(len(CLASS_NAMES))
    ]

    # Rule 5: Same JSON format / variable structure expected by frontend
    return {
        'status': 'ok',
        'label': final_label,
        'prediction': final_label,
        'message': return_message,
        'confidence': confidence_pct,
        'confidence_score': round(confidence_score, 4),
        'disease': disease_info,
        'available': True,
        'predictions': all_predictions,
        'class_index': predicted_index,
        'is_healthy': is_healthy,
        'probabilities': {
            CLASS_NAMES[i]: round(float(probabilities[i]), 4) for i in range(len(CLASS_NAMES))
        },
    }


