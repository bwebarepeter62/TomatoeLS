# ==========================================================
# Tomato Leaf Scan — Environment Configuration Example
# File: web-app/.env.example
# ==========================================================
# Copy this file to .env for custom deployment settings.
# The default local setup works out of the box without any edits.

FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# Optional AI Assistant / DeepSeek API Key (only needed if using the optional assistant)
# DEEPSEEK_API_KEY=your_optional_api_key_here
